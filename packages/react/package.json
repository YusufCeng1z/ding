{
  "name": "@yusufceng1z/ding-react",
  "version": "0.0.3",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@yusufceng1z/ding": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": ">=18"
  },
  "description": "React renderer for Ding spring-physics toasts.",
  "homepage": "https://ding.yusufcengiz.dev",
  "bugs": { "url": "https://github.com/YusufCeng1z/ding/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufCeng1z/ding.git",
    "directory": "packages/react"
  },
  "keywords": [
    "toast",
    "notification",
    "spring",
    "animation",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Yusuf Cengiz"
}
